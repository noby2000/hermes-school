# ~/.omniroute/.env  (chmod 600). Сгенерируйте значения сами, сюда ничего не копируйте из чужих систем.
PORT=20128
OMNIROUTE_SERVER_HOST=127.0.0.1
DATA_DIR=/home/openclaw/.omniroute
INITIAL_PASSWORD=<DASHBOARD_PASSWORD>
JWT_SECRET=<openssl rand -base64 48>
API_KEY_SECRET=<openssl rand -hex 32>
STORAGE_ENCRYPTION_KEY=<openssl rand -hex 32>
REQUIRE_API_KEY=true
OMNIROUTE_MEMORY_MB=448
# Ключ, который OpenClaw использует для доступа к OmniRoute (создаётся в дашборде OmniRoute):
OMNIROUTE_API_KEY=<YOUR_OMNIROUTE_API_KEY>
